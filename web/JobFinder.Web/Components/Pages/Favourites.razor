@page "/favourites"
@inherits FilteredPageBase
@inject IDbContextFactory<JobDbContext> DbFactory
@inject CoverLetterService Letters

<PageTitle>Favourites - Job Finder</PageTitle>

<div class="mode-toggle" role="group" aria-label="Which site's favourites to show">
    <button type="button" class="@(IsTradeMe ? "" : "active")" aria-pressed="@(!IsTradeMe)" @onclick="() => SetSourceAsync(JobSources.Seek)">SEEK</button>
    <button type="button" class="@(IsTradeMe ? "active" : "")" aria-pressed="@IsTradeMe" @onclick="() => SetSourceAsync(JobSources.TradeMe)">Trade Me</button>
</div>

<div class="mode-toggle" role="group" aria-label="What clicking a job does">
    <button type="button" class="@(coverMode ? "active" : "")" aria-pressed="@coverMode" @onclick="ToggleCoverMode">Generate Cover Letter</button>
</div>

@if (coverMode)
{
    <p class="queue-message" role="status">
        Cover letter mode is on. Click a job to write its cover letter from your CV, or to open the one you already saved.
        Your CV, API key and prompt are on the <a href="documents">Documents</a> page.
    </p>
}

<section class="filters" aria-label="Search and filter favourites">
    <label class="field field-wide">
        <span>Keyword</span>
        <input type="search" placeholder="Title, company, ad text, skills, email, phone or contact person"
               @bind="Filter.Keyword" @bind:event="oninput" @bind:after="ApplyAsync" />
    </label>

    @* Trade Me only places a job in a large district, so it gets a District filter instead of Location. *@
    @if (IsTradeMe)
    {
        <label class="field">
            <span>District</span>
            <select @bind="Filter.District" @bind:after="ApplyAsync">
                <option value="">All districts</option>
                @foreach (var d in districts)
                {
                    <option value="@d">@d</option>
                }
            </select>
        </label>
    }
    else
    {
        <label class="field">
            <span>Location</span>
            <select @bind="Filter.Location" @bind:after="ApplyAsync">
                <option value="">All locations</option>
                @foreach (var l in locations)
                {
                    <option value="@l">@l</option>
                }
            </select>
        </label>
    }

    <label class="field">
        <span>Contact details</span>
        <select @bind="Filter.Contact" @bind:after="ApplyAsync">
            <option value="">Any</option>
            <option value="phone">Phone only</option>
            <option value="email">Email only</option>
            <option value="both">Phone &amp; email</option>
            <option value="none">No contact details</option>
        </select>
    </label>

    <label class="field">
        <span>Work hours</span>
        <select @bind="Filter.Hours" @bind:after="ApplyAsync">
            <option value="">Any</option>
            <option value="yes">Hours available</option>
            <option value="no">No hours found</option>
        </select>
    </label>

    <button type="button" class="link-button" @onclick="ClearAsync" disabled="@(!HasFilters)">Clear filters</button>
</section>

<p class="result-count" aria-live="polite">
    @if (loading)
    {
        <text>Loading favourites...</text>
    }
    else
    {
        <text>@total @(total == 1 ? "job" : "jobs")@(HasFilters ? " match your filters" : " with full details")</text>
    }
</p>

@if (!loading && total == 0)
{
    <div class="empty">
        @if (HasFilters)
        {
            <p>No favourites match these filters. Try removing one or click Clear filters.</p>
        }
        else
        {
            <p>No @(IsTradeMe ? "Trade Me " : "SEEK ")favourites yet. On the Jobs page, filter to 75 jobs or fewer and click Queue details scrape, then click Scrape queued details in the extension.</p>
        }
    </div>
}

<div class="cards">
    @foreach (var job in items)
    {
        <JobCard Item="job" ExtraTags="PillsFor(job)" Note="@($"Details scraped {JobDisplay.Utc(job.Detail!.ScrapedAt)}")" OnSelected="Select" />
    }
</div>

@if (TotalPages > 1)
{
    <nav class="pager" aria-label="Pages">
        <button type="button" @onclick="PrevPageAsync" disabled="@(pageNumber <= 1)">Previous</button>
        <span>Page @pageNumber of @TotalPages</span>
        <button type="button" @onclick="NextPageAsync" disabled="@(pageNumber >= TotalPages)">Next</button>
    </nav>
}

@if (selected is { Detail: not null } sel)
{
    <div class="overlay" @onclick="Close">
        <div class="modal" role="dialog" aria-modal="true" aria-label="@sel.Title" @onclick:stopPropagation>
            <button type="button" class="close" @onclick="Close" aria-label="Close">Close</button>
            <h2>@sel.Title</h2>

            <h3>From the job page</h3>
            <DetailList Rows="JobDisplay.DetailRows(sel.Detail!, sel.Source)" />

            <h3>From the search results card</h3>
            <DetailList Rows="JobDisplay.JobRows(sel)" />
        </div>
    </div>
}

@if (letterJob is not null)
{
    <div class="overlay" @onclick="CloseLetter">
        <div class="modal" role="dialog" aria-modal="true" aria-label="Cover letter for @letterJob.Title" @onclick:stopPropagation>
            <button type="button" class="close" @onclick="CloseLetter" aria-label="Close">Close</button>
            <h2>Cover letter</h2>
            <p class="muted">@(letterJob.Detail?.Title is { Length: > 0 } t ? t : letterJob.Title)@(Company(letterJob) != "" ? $" at {Company(letterJob)}" : "")</p>

            @if (generating)
            {
                <p class="map-status" role="status">Writing your cover letter with Gemini. This usually takes 5 to 20 seconds...</p>
            }
            else
            {
                if (letterError is not null)
                {
                    <p class="map-status map-status-error" role="alert">@letterError</p>
                }
                if (letterSaved is not null || letterText != "")
                {
                    <p class="map-status" role="note">Check it carefully before you send it: names, facts and anything Gemini may have got wrong.</p>
                    <label class="field">
                        <span>Letter (edit as you like)</span>
                        <textarea rows="22" @bind="letterText" @bind:event="oninput"></textarea>
                    </label>
                    <p class="muted">
                        @WordCount(letterText) words.
                        @if (letterSaved is not null)
                        {
                            <text> Saved @JobDisplay.Utc(letterSaved.UpdatedAt).</text>
                        }
                        @if (Dirty)
                        {
                            <text> You have unsaved changes.</text>
                        }
                    </p>
                }
                <div class="actions">
                    <button type="button" class="primary" @onclick="SaveLetterAsync" disabled="@(!Dirty || letterText.Trim() == "")">Save</button>
                    @if (letterSaved is not null && !Dirty)
                    {
                        <a class="primary" href="@($"api/cover-letters/{Uri.EscapeDataString(letterJob.Id)}/docx")" download>Download .docx</a>
                    }
                    else
                    {
                        <span class="muted">Save to download as .docx</span>
                    }
                    <button type="button" class="link-button" @onclick="RegenerateAsync">@(letterSaved is null && letterText == "" ? "Generate" : "Regenerate")</button>
                    @if (letterSaved is not null)
                    {
                        <button type="button" class="link-button" @onclick="DeleteLetterAsync">Delete</button>
                    }
                </div>
                if (letterSaved is not null)
                {
                    <p class="muted">Regenerate replaces the saved letter, including your edits.</p>
                }
            }
        </div>
    </div>
}

@code {
    private const int PageSize = 24;

    private int pageNumber = 1, total;
    private bool loading = true;

    private List<Job> items = new();
    private List<string> locations = new(), districts = new();
    private Job? selected;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));

    /// <summary>
    /// Anything set on the filter counts, including work type, classification, listed and applicant strength
    /// when they arrive from the Map page. Those have no controls here and are applied silently.
    /// </summary>
    private bool HasFilters => Filter.Has(includeFavourite: true);

    private bool IsTradeMe => Filter.Source == JobSources.TradeMe;

    /// <summary>Runs on first load and whenever the query string changes (for example a district clicked on the Map page).</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (!ApplyQuery()) return;

        // The page always shows one site. Links without a site open the SEEK side.
        if (Filter.Source == "") Filter.Source = JobSources.Seek;

        pageNumber = 1;
        await LoadOptionsAsync();
        await LoadAsync();
    }

    /// <summary>The pills shown on a card: how to make contact, and whether the ad lists work hours.</summary>
    private IReadOnlyList<Pill> PillsFor(Job job)
    {
        var d = job.Detail!;
        var pills = new List<Pill>();
        if (withLetters.Contains(job.Id)) pills.Add(new Pill("Cover letter", "tag-letter"));

        var hasPhone = d.Phones != "";
        var hasEmail = d.Emails != "";
        if (hasPhone && hasEmail) pills.Add(new Pill("Phone & email", "tag-contact"));
        else if (hasPhone) pills.Add(new Pill("Phone", "tag-contact"));
        else if (hasEmail) pills.Add(new Pill("Email", "tag-contact"));

        if (HoursDetector.Has(d.Description)) pills.Add(new Pill("Hours available", "tag-hours"));
        return pills;
    }

    /// <summary>The locations (SEEK) and districts (Trade Me) that this site's favourites have, for the filters.</summary>
    private async Task LoadOptionsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var src = Filter.Source;
        var scoped = db.Jobs.Where(j => j.Detail != null && j.Source == src);

        locations = await scoped.Where(j => j.Location != "").Select(j => j.Location).Distinct().OrderBy(l => l).ToListAsync();
        districts = await scoped.Where(j => j.District != "").Select(j => j.District).Distinct().OrderBy(d => d).ToListAsync();

        // Keep a value that came in through the link selectable even if it has no favourites.
        if (Filter.Location != "" && !locations.Contains(Filter.Location))
        {
            locations.Add(Filter.Location);
            locations.Sort(StringComparer.Ordinal);
        }
        if (Filter.District != "" && !districts.Contains(Filter.District))
        {
            districts.Add(Filter.District);
            districts.Sort(StringComparer.Ordinal);
        }
    }

    /// <summary>Switches between the SEEK and Trade Me favourites. Each side has its own filters, so they start fresh.</summary>
    private async Task SetSourceAsync(string source)
    {
        if (Filter.Source == source) return;
        Filter.Clear();
        Filter.Source = source;
        await LoadOptionsAsync();
        await ApplyAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();

        var q = JobQueries.Apply(db.Jobs.AsNoTracking().Include(j => j.Detail), Filter, favourites: true);
        var ordered = q.OrderByDescending(j => j.Detail!.ScrapedAt);

        if (!JobQueries.HoursActive(Filter, favourites: true))
        {
            total = await q.CountAsync();
            if (pageNumber > TotalPages) pageNumber = TotalPages;
            items = await ordered.Skip((pageNumber - 1) * PageSize).Take(PageSize).ToListAsync();
        }
        else
        {
            // Hours are found by reading the ad text, which the database can't do, so this filter runs here.
            // The list of favourites is small, so loading the matches is fine.
            var matched = (await ordered.ToListAsync())
                .Where(j => JobQueries.HoursMatch(j.Detail!.Description, Filter))
                .ToList();

            total = matched.Count;
            if (pageNumber > TotalPages) pageNumber = TotalPages;
            items = matched.Skip((pageNumber - 1) * PageSize).Take(PageSize).ToList();
        }

        withLetters = await Letters.JobIdsWithLettersAsync(items.Select(j => j.Id));
        loading = false;
    }

    private async Task ApplyAsync()
    {
        pageNumber = 1;
        await LoadAsync();
    }

    private async Task ClearAsync()
    {
        Filter.Clear();
        await ApplyAsync();
    }

    private async Task PrevPageAsync()
    {
        if (pageNumber > 1) { pageNumber--; await LoadAsync(); }
    }

    private async Task NextPageAsync()
    {
        if (pageNumber < TotalPages) { pageNumber++; await LoadAsync(); }
    }

    private async Task Select(Job job)
    {
        if (!coverMode) { selected = job; return; }
        await OpenLetterAsync(job);
    }
    private void Close() => selected = null;

    // ---- Cover letters ----

    private bool coverMode, generating;
    private Job? letterJob;
    private CoverLetter? letterSaved;
    private string letterText = "";
    private string? letterError;
    private HashSet<string> withLetters = new();

    private bool Dirty => letterText.Trim() != (letterSaved?.Text ?? "").Trim();

    private void ToggleCoverMode() => coverMode = !coverMode;

    /// <summary>Opens the saved letter for the job, or writes one if there isn't one yet.</summary>
    private async Task OpenLetterAsync(Job job)
    {
        letterJob = job;
        letterError = null;
        letterSaved = await Letters.GetAsync(job.Id);
        letterText = letterSaved?.Text ?? "";
        if (letterSaved is null) await GenerateAsync();
    }

    private async Task RegenerateAsync() => await GenerateAsync();

    private async Task GenerateAsync()
    {
        if (letterJob is null) return;
        var job = letterJob;
        generating = true;
        letterError = null;
        StateHasChanged();
        try
        {
            var letter = await Letters.GenerateAsync(job);
            if (letterJob?.Id != job.Id) return;   // closed or switched while it was writing
            letterSaved = letter;
            letterText = letter.Text;
            withLetters.Add(job.Id);
        }
        catch (Exception ex)
        {
            letterError = ex.Message;
        }
        finally
        {
            generating = false;
        }
    }

    private async Task SaveLetterAsync()
    {
        if (letterJob is null) return;
        try
        {
            await Letters.SaveAsync(letterJob.Id, letterText);
            letterSaved = await Letters.GetAsync(letterJob.Id);
            letterText = letterSaved?.Text ?? letterText;
            withLetters.Add(letterJob.Id);
            letterError = null;
        }
        catch (Exception ex)
        {
            letterError = ex.Message;
        }
    }

    private async Task DeleteLetterAsync()
    {
        if (letterJob is null) return;
        await Letters.DeleteAsync(letterJob.Id);
        withLetters.Remove(letterJob.Id);
        letterSaved = null;
        letterText = "";
    }

    private void CloseLetter()
    {
        letterJob = null;
        letterSaved = null;
        letterText = "";
        letterError = null;
    }

    private static string Company(Job j) => j.Detail?.Advertiser is { Length: > 0 } a ? a : j.Company;

    private static int WordCount(string s) =>
        s.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;
}

@page "/"
@inject IDbContextFactory<JobDbContext> DbFactory

<PageTitle>Job Finder</PageTitle>

<section class="filters" aria-label="Job filters">
    <label class="field field-wide">
        <span>Keyword</span>
        <input type="search" placeholder="Title, company or description"
               @bind="keyword" @bind:event="oninput" @bind:after="ApplyFiltersAsync" />
    </label>

    <label class="field">
        <span>Location</span>
        <select @bind="location" @bind:after="ApplyFiltersAsync">
            <option value="">All locations</option>
            @foreach (var l in locations)
            {
                <option value="@l">@l</option>
            }
        </select>
    </label>

    <label class="field">
        <span>Work type</span>
        <select @bind="workType" @bind:after="ApplyFiltersAsync">
            <option value="">All work types</option>
            @foreach (var w in workTypes)
            {
                <option value="@w">@w</option>
            }
        </select>
    </label>

    <label class="field">
        <span>Classification</span>
        <select @bind="classification" @bind:after="OnClassificationChangedAsync">
            <option value="">All classifications</option>
            @foreach (var c in classifications)
            {
                <option value="@c">@c</option>
            }
        </select>
    </label>

    <label class="field">
        <span>Sub-classification</span>
        <select @bind="subClass" @bind:after="ApplyFiltersAsync">
            <option value="">All sub-classifications</option>
            @foreach (var s in subClasses)
            {
                <option value="@s">@s</option>
            }
        </select>
    </label>

    <label class="field">
        <span>Listed</span>
        <select @bind="listedDays" @bind:after="ApplyFiltersAsync">
            <option value="0">Any time</option>
            <option value="1">Last 24 hours</option>
            <option value="3">Last 3 days</option>
            <option value="7">Last 7 days</option>
            <option value="14">Last 14 days</option>
            <option value="30">Last 30 days</option>
        </select>
    </label>

    <label class="field">
        <span>Applicant strength</span>
        <select @bind="applicant" @bind:after="ApplyFiltersAsync">
            <option value="">Any</option>
            <option value="strong">Strong applicant</option>
            <option value="very">Very strong applicant</option>
            <option value="both">Strong or very strong</option>
        </select>
    </label>

    <button type="button" class="link-button" @onclick="ClearFiltersAsync" disabled="@(!HasFilters)">Clear filters</button>
</section>

<p class="result-count" aria-live="polite">
    @if (loading)
    {
        <text>Loading jobs...</text>
    }
    else
    {
        <text>@total @(total == 1 ? "job" : "jobs")@(HasFilters ? " match your filters" : " saved")</text>
    }
</p>

<section class="queue-bar" aria-label="Detail scrape queue">
    <button type="button" class="primary" @onclick="QueueAsync" disabled="@(!CanQueue)">Queue details scrape</button>
    <span class="queue-note">@QueueNote</span>
    @if (queueCount > 0)
    {
        <button type="button" class="link-button" @onclick="ClearQueueAsync">Clear queue (@queueCount waiting)</button>
    }
</section>

@if (queueMessage != "")
{
    <p class="queue-message" role="status">@queueMessage</p>
}

@if (!loading && total == 0)
{
    <div class="empty">
        @if (HasFilters)
        {
            <p>No jobs match these filters. Try removing one or click Clear filters.</p>
        }
        else
        {
            <p>No jobs yet. Scrape a SEEK page with the extension, then use Send to site (or turn on auto-send).</p>
        }
    </div>
}

<div class="cards">
    @foreach (var job in jobs)
    {
        <JobCard Item="job" OnSelected="Select" />
    }
</div>

@if (TotalPages > 1)
{
    <nav class="pager" aria-label="Pages">
        <button type="button" @onclick="PrevPageAsync" disabled="@(pageNumber <= 1)">Previous</button>
        <span>Page @pageNumber of @TotalPages</span>
        <button type="button" @onclick="NextPageAsync" disabled="@(pageNumber >= TotalPages)">Next</button>
    </nav>
}

@if (selected is not null)
{
    <div class="overlay" @onclick="Close">
        <div class="modal" role="dialog" aria-modal="true" aria-label="@selected.Title" @onclick:stopPropagation>
            <button type="button" class="close" @onclick="Close" aria-label="Close">Close</button>
            <h2>@selected.Title</h2>
            <DetailList Rows="JobDisplay.JobRows(selected)" />
        </div>
    </div>
}

@code {
    private const int PageSize = 24;

    /// <summary>The most jobs that can be queued for a detail scrape in one go.</summary>
    private const int MaxQueue = 75;

    private string keyword = "", location = "", workType = "", classification = "", subClass = "", applicant = "";
    private int listedDays, pageNumber = 1, total, queueCount;
    private bool loading = true;
    private string queueMessage = "";

    private List<Job> jobs = new();
    private List<string> locations = new(), workTypes = new(), classifications = new(), subClasses = new();
    private Job? selected;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));

    private bool HasFilters =>
        keyword.Trim() != "" || location != "" || workType != "" ||
        classification != "" || subClass != "" || applicant != "" || listedDays != 0;

    private bool CanQueue => !loading && total > 0 && total <= MaxQueue;

    private string QueueNote =>
        total == 0 ? "" :
        total > MaxQueue ? $"Too many jobs to queue ({total}). Narrow the filters to {MaxQueue} or fewer." :
        $"Queues the {total} filtered {(total == 1 ? "job" : "jobs")} so the extension can scrape their full details.";

    protected override async Task OnInitializedAsync()
    {
        await LoadOptionsAsync();
        await LoadQueueCountAsync();
        await LoadJobsAsync();
    }

    private static Task<List<string>> DistinctAsync(IQueryable<string> values) =>
        values.Where(s => s != "").Distinct().OrderBy(s => s).ToListAsync();

    private async Task LoadOptionsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        locations = await DistinctAsync(db.Jobs.Select(j => j.Location));
        workTypes = await DistinctAsync(db.Jobs.Select(j => j.WorkType));
        classifications = await DistinctAsync(db.Jobs.Select(j => j.Classification));

        var cls = classification;
        subClasses = await DistinctAsync(
            db.Jobs.Where(j => cls == "" || j.Classification == cls).Select(j => j.SubClass));
    }

    private async Task LoadQueueCountAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        queueCount = await db.QueuedJobs.CountAsync();
    }

    /// <summary>All jobs matching the current filters, ignoring paging.</summary>
    private IQueryable<Job> FilteredJobs(JobDbContext db)
    {
        var q = db.Jobs.AsNoTracking().AsQueryable();

        var k = keyword.Trim();
        if (k != "")
        {
            var pattern = $"%{k}%";
            q = q.Where(j => EF.Functions.Like(j.Title, pattern)
                          || EF.Functions.Like(j.Company, pattern)
                          || EF.Functions.Like(j.Description, pattern));
        }

        var loc = location; var wt = workType; var cls = classification; var sub = subClass;
        if (loc != "") q = q.Where(j => j.Location == loc);
        if (wt != "") q = q.Where(j => j.WorkType == wt);
        if (cls != "") q = q.Where(j => j.Classification == cls);
        if (sub != "") q = q.Where(j => j.SubClass == sub);

        if (applicant == "strong") q = q.Where(j => j.ApplicantStrength == ApplicantStrengths.Strong);
        else if (applicant == "very") q = q.Where(j => j.ApplicantStrength == ApplicantStrengths.VeryStrong);
        else if (applicant == "both") q = q.Where(j => j.ApplicantStrength != "");

        if (listedDays > 0)
        {
            var cutoff = DateTime.UtcNow.AddDays(-listedDays);
            q = q.Where(j => j.ListedDate != null && j.ListedDate >= cutoff);
        }

        return q;
    }

    private IOrderedQueryable<Job> InDisplayOrder(IQueryable<Job> q) =>
        q.OrderByDescending(j => j.ListedDate).ThenByDescending(j => j.ScrapedAt);

    private async Task LoadJobsAsync()
    {
        loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();

        var q = FilteredJobs(db);
        total = await q.CountAsync();
        if (pageNumber > TotalPages) pageNumber = TotalPages;

        jobs = await InDisplayOrder(q)
            .Skip((pageNumber - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();

        loading = false;
    }

    private async Task ApplyFiltersAsync()
    {
        pageNumber = 1;
        queueMessage = "";
        await LoadJobsAsync();
    }

    private async Task OnClassificationChangedAsync()
    {
        subClass = "";
        await LoadOptionsAsync();
        await ApplyFiltersAsync();
    }

    private async Task ClearFiltersAsync()
    {
        keyword = location = workType = classification = subClass = applicant = "";
        listedDays = 0;
        await LoadOptionsAsync();
        await ApplyFiltersAsync();
    }

    /// <summary>Replaces the queue with every job matching the current filters (all pages, not just this one).</summary>
    private async Task QueueAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var ids = await InDisplayOrder(FilteredJobs(db)).Select(j => j.Id).ToListAsync();

        if (ids.Count == 0 || ids.Count > MaxQueue)
        {
            queueMessage = ids.Count == 0
                ? "No jobs to queue."
                : $"Too many jobs to queue ({ids.Count}). Narrow the filters to {MaxQueue} or fewer.";
            return;
        }

        await db.QueuedJobs.ExecuteDeleteAsync();

        // Spread QueuedAt by a millisecond each so the extension scrapes them in the order shown here.
        var now = DateTime.UtcNow;
        db.QueuedJobs.AddRange(ids.Select((id, i) => new QueuedJob { JobId = id, QueuedAt = now.AddMilliseconds(i) }));
        await db.SaveChangesAsync();

        queueCount = ids.Count;
        queueMessage = $"Queued {ids.Count} {(ids.Count == 1 ? "job" : "jobs")}. In the extension, click Scrape queued details.";
    }

    private async Task ClearQueueAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.QueuedJobs.ExecuteDeleteAsync();
        queueCount = 0;
        queueMessage = "Queue cleared.";
    }

    private async Task PrevPageAsync()
    {
        if (pageNumber > 1) { pageNumber--; await LoadJobsAsync(); }
    }

    private async Task NextPageAsync()
    {
        if (pageNumber < TotalPages) { pageNumber++; await LoadJobsAsync(); }
    }

    private void Select(Job job) => selected = job;
    private void Close() => selected = null;
}

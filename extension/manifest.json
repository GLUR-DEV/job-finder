{
  "manifest_version": 3,
  "name": "SEEK Job Card Scraper",
  "version": "1.2.1",
  "description": "Reads job cards on SEEK search pages and exports them to CSV.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.seek.com.au/*",
    "https://*.seek.co.nz/*",
    "https://*.seek.com/*",
    "http://localhost:5000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.seek.com.au/*",
        "https://*.seek.co.nz/*",
        "https://*.seek.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SEEK Scraper"
  }
}
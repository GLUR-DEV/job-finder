{
  "manifest_version": 3,
  "name": "SEEK Job Card Scraper",
  "version": "1.6.3",
  "description": "Reads job cards on SEEK and Trade Me search pages and exports them to CSV.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://*.seek.com.au/*",
    "https://*.seek.co.nz/*",
    "https://*.seek.com/*",
    "https://*.trademe.co.nz/*",
    "http://localhost:5000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.seek.com.au/*",
        "https://*.seek.co.nz/*",
        "https://*.seek.com/*",
        "https://*.trademe.co.nz/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SEEK Scraper"
  }
}
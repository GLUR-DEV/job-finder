{
  "manifest_version": 3,
  "name": "SEEK Job Card Scraper",
  "version": "0.1.0",
  "description": "Reads job cards on SEEK search pages and exports them to CSV.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://*.seek.com.au/*",
    "https://*.seek.co.nz/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.seek.com.au/*", "https://*.seek.co.nz/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SEEK Scraper"
  }
}
